<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="stereo_camera">
    <pose>0 0 0 0 0 0</pose>

    <link name="camera_link">
      <pose>0 0 0 0 0 0</pose>

      <!-- Simple cube to visualize the camera -->
      <visual name="camera_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.1 0.1 0.05</size> <!-- width, depth, height -->
          </box>
        </geometry>
        <material>
          <ambient>0 0 1 1</ambient>
          <diffuse>0 0 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <!-- Left camera -->
      <sensor name="left_camera" type="camera">
        <pose>-0.06 0 0 0 0 0</pose> <!-- Half baseline left -->
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
      </sensor>

      <!-- Right camera -->
      <sensor name="right_camera" type="camera">
        <pose>0.06 0 0 0 0 0</pose> <!-- Half baseline right -->
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
      </sensor>

      <!-- Inertial properties -->
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>1e-5</ixx>
          <iyy>1e-5</iyy>
          <izz>1e-5</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

    </link>

    <plugin
        name="ignition::gazebo::systems::Sensors"
        filename="libignition-gazebo-sensors-system.so"/>

    <static>true</static>
  </model>
</sdf>
