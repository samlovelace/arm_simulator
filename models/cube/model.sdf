<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="cube">
    <pose>0 0 0 0 0 0</pose>

    <link name="main">
      <pose>0 0 0 0 0 0</pose>

      <!-- Simple cube to visualize the camera body -->
      <visual name="visual">
        <pose>0 0 -0.1 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.05</size>
          </box>
        </geometry>
        <material>
          <ambient>0 0 1 1</ambient>
          <diffuse>0 0 1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <collision name="collision">
        <pose>0 0 -0.1 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.05</size>
          </box>
        </geometry>
      </collision>

    <!-- Inertial properties -->
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>1e-5</ixx>
          <iyy>1e-5</iyy>
          <izz>1e-5</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link> 
  </model> 
</sdf> 